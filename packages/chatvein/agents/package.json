{
  "name": "@chatvein/agents",
  "version": "0.1.0",
  "description": "Agent runtime: LangChain createAgent (ReAct on LangGraph), role loading, tool binding for chat and group members",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@chatvein/common": "workspace:*",
    "@chatvein/context": "workspace:*",
    "@chatvein/models": "workspace:*",
    "@chatvein/observability": "workspace:*",
    "@chatvein/tools": "workspace:*",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "json-rules-engine": "^7.3.1",
    "langchain": "^1.5.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/json-rules-engine": "^4.1.0",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "license": "MIT"
}
