{
  "name": "@chatvein/agents",
  "version": "0.1.0",
  "description": "Chatvein agent factories — conversation graph / chat / router / tools-filter (pure Node)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./router": {
      "import": {
        "types": "./dist/router.d.mts",
        "default": "./dist/router.mjs"
      },
      "require": {
        "types": "./dist/router.d.ts",
        "default": "./dist/router.js"
      },
      "default": "./dist/router.js"
    },
    "./conversation": {
      "import": {
        "types": "./dist/conversation.d.mts",
        "default": "./dist/conversation.mjs"
      },
      "require": {
        "types": "./dist/conversation.d.ts",
        "default": "./dist/conversation.js"
      },
      "default": "./dist/conversation.js"
    },
    "./model": {
      "import": {
        "types": "./dist/model.d.mts",
        "default": "./dist/model.mjs"
      },
      "require": {
        "types": "./dist/model.d.ts",
        "default": "./dist/model.js"
      },
      "default": "./dist/model.js"
    },
    "./tools-filter": {
      "import": {
        "types": "./dist/tools-filter.d.mts",
        "default": "./dist/tools-filter.mjs"
      },
      "require": {
        "types": "./dist/tools-filter.d.ts",
        "default": "./dist/tools-filter.js"
      },
      "default": "./dist/tools-filter.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/openai": "^1.5.11",
    "deepagents": "^1.13.3",
    "es-toolkit": "^1.52.0",
    "langchain": "^1.5.10",
    "lru-cache": "^11.5.2",
    "mime-types": "^3.0.2",
    "ml-distance": "^5.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "license": "MIT"
}
