{
  "name": "@chatvein/tools",
  "version": "0.1.0",
  "description": "Agent tool layer: file/shell/git/search tools with timeout, output truncation and command allowlist",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@chatvein/common": "workspace:*",
    "@chatvein/mcp-modsearch-sdk": "workspace:*",
    "@chatvein/mcp-openfile-sdk": "workspace:*",
    "@chatvein/mcp-vmsandbox-sdk": "workspace:*",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.9",
    "@langchain/mcp-adapters": "^1.1.4",
    "@modelcontextprotocol/server-filesystem": "2026.8.31",
    "duck-duck-scrape": "^2.2.7",
    "es-toolkit": "^1.52.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@langchain/langgraph": "^1.4.10"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "license": "MIT"
}
