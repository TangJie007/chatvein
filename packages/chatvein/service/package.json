{
  "name": "@chatvein/service",
  "version": "0.1.0",
  "description": "Headless Node runner for Chatvein: forge CLI (run/resume/preview/regression) and sidecar server",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "forge": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@chatvein/common": "workspace:*",
    "@chatvein/core": "workspace:*",
    "@chatvein/orchestrator": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.2",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "cac": "^7.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "license": "MIT"
}
