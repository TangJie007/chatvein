{
  "name": "chatvein",
  "version": "0.1.0",
  "private": true,
  "description": "Chatvein/Forge — @electrum/* Electron shell framework + @chatvein/* Agent Harness",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm --filter @electrum/common --filter @electrum/core --filter @electrum/preload --filter @electrum/client --filter @electrum/testing --filter @electrum/codegen run build && pnpm --filter @chatvein/* run build",
    "build:harness": "pnpm --filter @chatvein/* run build",
    "dev:app": "pnpm --filter @electrum/chatvein dev",
    "build:app": "pnpm --filter @electrum/chatvein build",
    "test": "pnpm --filter @electrum/core --filter @electrum/preload --filter @electrum/client run test && pnpm --filter @chatvein/* run test",
    "test:harness": "pnpm --filter @chatvein/* run test",
    "check": "node scripts/check-boundaries.mjs",
    "verify:harness": "pnpm check && pnpm build:harness && pnpm test:harness",
    "clean": "pnpm -r exec rimraf dist out",
    "clean:lock": "rimraf pnpm-lock.yaml node_modules",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "mcp:inspect": "mcp-inspector",
    "mcp:inspect:openfile": "pnpm --filter @chatvein/mcp-openfile-sdk build && mcp-inspector node packages/mcps/openfile/dist/cli.js",
    "mcp:inspect:modsearch": "pnpm --filter @chatvein/mcp-modsearch-sdk build && mcp-inspector node packages/mcps/modsearch/dist/cli.js",
    "mcp:inspect:vmsandbox": "pnpm --filter @chatvein/mcp-vmsandbox-sdk build && mcp-inspector node packages/mcps/vmsandbox/dist/cli.js .",
    "mcp:inspect:shellsandbox": "pnpm --filter @chatvein/mcp-shellsandbox-sdk build && mcp-inspector node packages/mcps/shellsandbox/dist/cli.js .",
    "mcp:inspect:pyodide": "pnpm --filter @chatvein/mcp-pyodide-sdk build && mcp-inspector node packages/mcps/pyodide/dist/cli.js .",
    "mcp:inspect:playwright": "mcp-inspector node node_modules/@playwright/mcp/cli.js --headless"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.5.0",
    "@wetspace/wetspec-cli": "^1.2.2",
    "rimraf": "^6.1.3",
    "vitepress": "^1.6.4"
  }
}
