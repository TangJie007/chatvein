{
  "name": "chatvein",
  "version": "0.1.0",
  "private": true,
  "description": "Chatvein — desktop AI workbench built on the Electrum framework",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @electrum/chatvein dev",
    "build": "pnpm run build:packages && pnpm --filter @electrum/chatvein build",
    "build:packages": "pnpm -r --filter \"./packages/electrum/*\" build",
    "codegen": "pnpm --filter @electrum/codegen build && pnpm --filter @electrum/chatvein codegen",
    "typecheck": "pnpm --filter @electrum/chatvein typecheck",
    "test": "pnpm -r --filter \"./packages/electrum/*\" test"
  }
}
