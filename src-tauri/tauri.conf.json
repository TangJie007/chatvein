{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatVein",
  "version": "0.1.0",
  "identifier": "com.chatvein.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prepare:runtime && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ChatVein",
        "label": "main",
        "width": 1300,
        "height": 800,
        "minWidth": 1300,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost https://cloudcache.tencent-cloud.com https://cloudcache.tencent-cloud.cn https://skillhub.cn data:; connect-src 'self' ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist-backend": "backend-runtime"
    }
  }
}
