{
  "name": "@electrum/chatvein",
  "version": "0.1.0",
  "private": true,
  "description": "Chatvein Forge — desktop AI workbench shell (@electrum)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron .",
    "preview": "electron-vite preview",
    "codegen": "node node_modules/@electrum/codegen/dist/cli.js --tsconfig tsconfig.json --output src/renderer/api/ipc-api.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@electrum/client": "workspace:*",
    "@electrum/common": "workspace:*",
    "@electrum/core": "workspace:*",
    "@electrum/preload": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@electrum/codegen": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
