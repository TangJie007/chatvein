# 编辑器基础口径：不同 IDE / 系统上不让缩进、换行、编码把 diff 弄脏。
# 前端无 ESLint 配置，格式一致性靠这份文件 + `npm run typecheck` + 人工 review。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{ps1,psm1}]
indent_size = 4

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2
